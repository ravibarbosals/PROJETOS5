# API
NODE_ENV=development
PORT=3000

# PostgreSQL local (compose.yml). O compose cria o banco POSTGRES_DB com o usuário postgres.
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vigia

# Conexão do back com o banco (DEC-024).
# - Postgres local, back rodando fora do Docker (npm run start:dev, e2e):
#     postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/vigia
#   Dentro do compose, o compose.yml troca o host para db.
# - Neon: a connection string do painel, terminando em ?sslmode=verify-full.
#   Para migrations, use o host sem -pooler. Nunca rode os e2e no Neon.
DATABASE_URL=postgresql://postgres:troque-esta-senha@localhost:5432/vigia

# Autenticação (DEC-013). Segredo com 32+ caracteres; gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_EXPIRES_IN=8h

# Primeiro administrador (TASK-016), usado só por `npm run seed:admin`.
# Idempotente: se já existe um ADM, nada é alterado. Senha com 8+ caracteres (PR-020).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.gov.br
ADMIN_SENHA=troque-esta-senha

# Dados de demonstração (TASK-050), usados só por `npm run seed:demo`.
# Senha dos 4 usuários *@demo.vigia.local (8+ caracteres). Só roda no Postgres local.
DEMO_SENHA=troque-esta-senha

# Job de alertas (DEC-015, RN-015). Valores padrão se omitidos: 10, 2 e 6.
ALERTA_INTERVALO_MINUTOS=10
ALERTA_ESTABILIZACAO_HORAS=2
ALERTA_EXPIRACAO_HORAS=6